<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      RECORD_AUDIO was deliberately absent until Phase 5 (PLAN.md §11.4).
      Every measured run is file-fed: audio reaches the recognizer through a
      ParcelFileDescriptor pipe via RecognizerIntent.EXTRA_AUDIO_SOURCE, or
      straight into the model, and needs no microphone access at all. It is
      declared now for the single real-microphone check (§10 step 20), and
      only MicCheckActivity asks for it: the owner grants it on the phone, and
      nothing else in the harness records.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Keeps the CPU awake for the duration of a run. Without it the device
      dozes between paced frames on long clips: SystemClock.uptimeMillis()
      stops advancing while wall-clock time passes, so the feeder believes it
      is on schedule while the model is actually being starved of audio in
      real time. A 6-minute session took 17 minutes of wall clock this way and
      reported 253 ms of slip.

      A partial wake lock, not a screen-on flag: it keeps the CPU running
      without the display's power draw and heat, which matters on a device
      whose thermal behaviour is part of the measurement.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Arm A resolves the platform recognizer service by intent. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:label="ASR Bench"
        android:supportsRtl="true">

        <!--
          No launcher Activity. This is a headless instrument driven by
          `adb shell am instrument`; a demo UI comes after there are numbers.
          The one activity is the microphone check's script and permission
          prompt, opened by BenchmarkTest#micCheck through the shell (`am
          start`): MIUI refuses an app opening its own screen from the
          background, and the instrumented app is in the background. Exported
          for that reason only, and guarded by DUMP, which the shell and the
          system hold and no installed app can: nothing else can open it.
        -->
        <activity
            android:name=".MicCheckActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:label="ASR Bench mic check" />
    </application>
</manifest>
